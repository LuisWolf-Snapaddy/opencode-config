{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "share": "disabled",
  // Best model for most tasks (especially code generation)
  "model": "openai/gpt-6.1-sol",
  "instructions": [".github/copilot-instructions.md"],
  "mcp": {
    "servers": {
      "angular-cli": {
        "type": "local",
        "command": ["pnpm", "dlx", "-y", "@angular/cli", "mcp", "--experimental-tool"],
        "disabled": false
      },
      "astro": {
        "type": "remote",
        "url": "https://mcp.docs.astro.build/mcp",
        "disabled": true
      },
      "snapaddy-components": {
        "type": "local",
        "command": [
          "pnpm",
          "dlx",
          "-y",
          "markdown-mcp-resource@latest",
          "https://components.snapaddy.com/assets/mcp/index.json"
        ],
        "disabled": false
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--no-usage-statistics"],
        "disabled": true
      },
      "postgres": {
        "type": "local",
        "command": [
          "pnpm",
          "dlx",
          "-y",
          "@modelcontextprotocol/server-postgres",
          "postgres://sa_backend:mySecretDBPassword@localhost:5432/postgres"
        ],
        "disabled": true
      },
      "i18n-editor": {
        "type": "local",
        "command": [
          "pnpm",
          "dlx",
          "-y",
          "@snapaddy/i18n-cli@latest",
          "mcp"
        ],
        "disabled": false
      },
      "workflow-docs": {
        "type": "local",
        "command": [
          "pnpm",
          "dlx",
          "-y",
          "markdown-mcp-resource@latest",
          "https://workflow-docs.snapaddy.com/assets/mcp/index.json"
        ],
        "disabled": true
      }
    }
  },
  "permissions": [
    // Preserve V1's prompt before accessing directories outside the project.
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    // Ask for permission to run these commands.
    { "action": "shell", "resource": "npm install", "effect": "ask" },
    { "action": "shell", "resource": "npm install *", "effect": "ask" },
    { "action": "shell", "resource": "git commit", "effect": "ask" },
    { "action": "shell", "resource": "git push", "effect": "ask" }
  ],
  "experimental": {
    "todo": true
  },
  "providers": {
    "openai": {
      "models": {
        "gpt-6.1-sol": {
          "variants": [
            { "id": "code-reviewer", "body": { "temperature": 0.2 } }
          ]
        },
        "gpt-6-luna": {
          "variants": [
            { "id": "document-writer", "body": { "temperature": 0.3 } }
          ]
        }
      }
    }
  },
  "agents": {
    // Free model for quick tasks.
    "title": {
      "model": "openai/gpt-6-luna"
    },
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues.",
      "mode": "primary",
      // Good model for web-dev tasks
      "model": "openai/gpt-6.1-sol#code-reviewer",
      // Can only read files but not write or edit them
      "permissions": [
        // Preserve the original rule order: the final wildcard asks for all shell commands.
        { "action": "shell", "resource": "git status *", "effect": "allow" },
        { "action": "shell", "resource": "git diff *", "effect": "allow" },
        { "action": "shell", "resource": "git log *", "effect": "allow" },
        { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
        { "action": "shell", "resource": "git merge-base *", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
        { "action": "todowrite", "resource": "*", "effect": "allow" },
        { "action": "todoread", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "ask" }
      ],
      "system": "{file:./prompts/code-reviewer.md}"
    },
    "document-writer": {
      "description": "Writes documentation for codebases.",
      "mode": "primary",
      // Free model to be used more often
      "model": "openai/gpt-6-luna#document-writer",
      // Preserve the effective edit permission: the original final patch rule allowed edits.
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
        { "action": "todowrite", "resource": "*", "effect": "allow" },
        { "action": "todoread", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" }
      ],
      "system": "{file:./prompts/document-writer.md}"
    }
  }
}
